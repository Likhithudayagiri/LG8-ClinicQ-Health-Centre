            },
            "url": {
              "raw": "{{baseUrl}}/bookings/",
              "host": ["{{baseUrl}}"],
              "path": ["bookings", ""]
            },
            "description": "Attempts to schedule Doctor 1 for two different rooms at the exact same date and time. Must be rejected with 400 Conflict."
          },
          "response": []
        },
