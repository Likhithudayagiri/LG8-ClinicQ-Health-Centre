        {
          "name": "Conflict Test 1 - Same Room at Same Time [Expected: 400 Bad Request]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctor_id\": 2,\n  \"room_id\": 1,\n  \"booking_date\": \"2026-11-20\",\n  \"booking_time\": \"10:00\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/bookings/",
              "host": ["{{baseUrl}}"],
              "path": ["bookings", ""]
            },
            "description": "Attempts to book Room 1 at the same date and time by a different doctor. Must be rejected with 400 Conflict."
          },
          "response": []
        },
        {
          "name": "Conflict Test 2 - Same Doctor at Same Time [Expected: 400 Bad Request]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
