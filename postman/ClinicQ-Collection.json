    "name": "ClinicQ Health Centre API - LG 8",
    "description": "Postman Collection for ClinicQ Health Centre Consultation Room & Doctor Scheduling Backend System.\nIncludes all CRUD endpoints, search, validations, mandatory twist tests, conflict prevention tests, and the mandatory SQL JOIN endpoint.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Mandatory Twist Tests",
      "description": "The three compulsory twist tests specified in Section 8.",
      "item": [
        {
          "name": "TEST 1: POST /rooms/ (Ground floor) [Expected: 201 Created]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"room_name\": \"Consultation Room A\",\n  \"floor\": \"Ground\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/rooms/",
              "host": ["{{baseUrl}}"],
              "path": ["rooms", ""]
            },
            "description": "TEST 1: Creates Consultation Room A on Ground floor. Expected HTTP Status: 201 Created."
          },
          "response": []
        },
        {
          "name": "TEST 2: POST /rooms/ (Invalid floor: Other) [Expected: 400 Bad Request]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"room_name\": \"Consultation Room B\",\n  \"floor\": \"Other\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/rooms/",
              "host": ["{{baseUrl}}"],
              "path": ["rooms", ""]
            },
            "description": "TEST 2: Attempts to create room with floor 'Other'. Expected HTTP Status: 400 Bad Request with error: 'Invalid floor. Allowed values are: Ground, First, Second'."
          },
          "response": []
        },
        {
          "name": "TEST 3: PUT /rooms/1/ (Update floor to First) [Expected: 200 OK]",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"room_name\": \"Consultation Room A\",\n  \"floor\": \"First\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/rooms/1/",
              "host": ["{{baseUrl}}"],
              "path": ["rooms", "1", ""]
            },
            "description": "TEST 3: Updates Room 1 floor to 'First'. Expected HTTP Status: 200 OK."
          },
          "response": []
        }
      ]
    },
    {
